#
# GovDesk backend configuration — EXAMPLE / template.
#
# Copy this file to `.env` in the same folder and fill in the values you have:
#     cp .env.example .env       (macOS/Linux)
#     Copy-Item .env.example .env  (PowerShell)
#
# EVERYTHING IS OPTIONAL. With no keys set, the app runs in "mock" mode:
# research and market data use deterministic mock payloads, the LLM returns a
# templated response, and JEV is shown honestly as "unavailable" (non-blocking).
# Add keys to switch the matching provider from mock to live automatically.
#
# Do NOT put real secrets in this .example file. Keep real values only in .env
# (which is gitignored). Placeholders below show the shape, not real keys.

# ---------------------------------------------------------------------------
# LLM — Strategy agent's trade thesis (Groq primary, Gemini optional fallback)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# Groq model used by the Strategy agent (OpenAI-compatible model id).
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Research & market data
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# JEV — per-agent output safety judge
# Resolution order: JEV_API_KEY (OpenRouter) -> GROQ_MODEL_2 (Groq fallback)
# -> "unavailable". If neither is set, JEV is non-blocking and shown honestly.
# ---------------------------------------------------------------------------
# Primary: Jev — a TypeSafe "System One" DECISION model on OpenRouter (called
# via the Decisions API, not chat). Only an OpenRouter API key is needed.
# ~typesafe/jev-latest tracks the newest release; pin jev-1.13 for stability.
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Fallback: a SECOND Groq API key (the name is historical — it holds a KEY, not
# a model). Kept separate from GROQ_API_KEY so JEV has its own rate-limit budget.
GROQ_MODEL_2=
# Groq model used for the JEV fallback (OpenAI-compatible model id).
GROQ_JEV_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Audit signing (optional) — hex string, >= 32 bytes. Enables a persistent,
# HMAC-signed audit sink in addition to the in-memory hash chain.
# ---------------------------------------------------------------------------
AGT_AUDIT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Store & server (optional — defaults shown)
# ---------------------------------------------------------------------------
GOVDESK_DB=govdesk.db
GOVDESK_HOST=127.0.0.1
GOVDESK_PORT=8099
# Comma-separated origins allowed to call the API (the Vite dev server).
GOVDESK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
